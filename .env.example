# Verity (Bharat Shield) - Environment Configuration
# ==============================================================================
# NOTE: Verity is 100% on-device and privacy-first.
# Core threat scanning requires ZERO external API keys or cloud credentials.
# The variables below are purely optional for local development, demo, and testing.
# ==============================================================================

# Port for the local Grand Jury Demo Command Center and evaluation server
PORT=8080

# Environment mode: 'development', 'test', or 'production'
# In 'test' mode, non-critical diagnostic logs are silenced.
NODE_ENV=development

# Privacy-preserving DNS-over-HTTPS resolver for unfamiliar hostname reputation lookups
# Verity sends only the hostname (never paths, parameters, or user tokens).
VERITY_DOH_RESOLVER=https://security.cloudflare-dns.com/dns-query

# Enable development allowlist for local loopback test server (127.0.0.1 / localhost)
ENABLE_DEV_ALLOWLIST=false
